<Application x:Class="OpBuds.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OpBuds.App.ViewModels"
             ShutdownMode="OnExplicitShutdown">

    <!--
        OnExplicitShutdown, not OnLastWindowClose: closing the window hides it to the tray,
        and on autostart there may never be a window at all.
    -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <vm:EnumMatchConverter x:Key="EnumMatch" />
            <vm:EqualityMultiConverter x:Key="Equality" />
            <vm:HasValueConverter x:Key="HasValue" />
            <vm:NullDashConverter x:Key="NullDash" />
            <vm:PercentConverter x:Key="Percent" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!--
                Literal white, not an override of WPF-UI's TextFillColor* keys. Overriding
                those was tried and produced an app that laid out perfectly and painted
                nothing: the keys are rewritten by WPF-UI's own theme manager at runtime,
                so ours and theirs took turns winning and the text ended up the same colour
                as whatever was behind it. A literal cannot be overwritten by anything.

                White text only makes sense on a dark surface, so the app is dark-only -
                see ThemeSupport.Apply.
            -->
            <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="InkDim" Color="#B8FFFFFF" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="2,0,0,6" />
            </Style>

            <!-- Kept for hierarchy: still white, just smaller. -->
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!--
                The battery badges, matching the phone's: a filled case outline and filled
                L / R discs with the letter knocked out. Small on purpose - the number is
                the information, the badge only says which number it is.
            -->
            <Style x:Key="BatteryValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="5,0,16,0" />
            </Style>

            <Style x:Key="BudLetter" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />

                <!-- Knocked out of the white badge, so it is the surface colour. -->
                <Setter Property="Foreground" Value="#FF16161A" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
