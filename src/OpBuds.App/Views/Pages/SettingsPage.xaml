<UserControl x:Class="OpBuds.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer Padding="16,4,16,16" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ui:InfoBar Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="{Binding RestartRequired, Mode=OneWay}"
                        Message="Restart OpBuds for this to take effect."
                        Severity="Informational"
                        Title="Restart needed" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="STARTUP" />
            <Border Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <ui:ToggleSwitch Margin="0,2"
                                     Content="Start with Windows"
                                     IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    <TextBlock Margin="0,0,0,8"
                               FontSize="13"
                               Style="{StaticResource Muted}"
                               Text="Reads the registry Run entry directly, so it stays honest if you remove it from Task Manager." />

                    <ui:ToggleSwitch Margin="0,2"
                                     Content="Start minimised to the tray"
                                     IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                    <ui:ToggleSwitch Margin="0,2"
                                     Content="Closing the window hides it to the tray"
                                     IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="POLLING" />
            <Border Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="13" Text="{Binding PollSecondsVisible, StringFormat=Battery poll while the window is open: {0}s}" />
                    <Slider Margin="0,6,0,0"
                            IsSnapToTickEnabled="True"
                            Maximum="60"
                            Minimum="2"
                            TickFrequency="1"
                            Value="{Binding PollSecondsVisible, Mode=TwoWay}" />
                    <TextBlock FontSize="13"
                               Style="{StaticResource Muted}"
                               Text="Battery is never pushed by the earbuds, so it has to be asked for. Tray-only drops to 30s and idle to 120s automatically." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="DEVICE" />
            <Border Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,6" FontSize="13" Text="Bluetooth address" />
                    <ui:TextBox FontFamily="Consolas"
                                PlaceholderText="AA:BB:CC:DD:EE:FF"
                                Text="{Binding DeviceMac, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="DIAGNOSTICS" />
            <Border Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <ui:ToggleSwitch Content="Write a protocol capture to disk" IsChecked="{Binding ProtocolLogging, Mode=TwoWay}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="13"
                               Style="{StaticResource Muted}"
                               Text="JSONL, in the same format the Python probe writes, so a capture can be replayed offline by the CLI." />

                    <TextBlock Margin="0,10,0,0"
                               FontFamily="Consolas"
                               FontSize="13"
                               Style="{StaticResource Muted}"
                               Text="{Binding SettingsPath}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Secondary"
                                   Command="{Binding OpenSettingsFolderCommand}"
                                   Content="Settings folder" />
                        <ui:Button Appearance="Secondary"
                                   Command="{Binding OpenLogFolderCommand}"
                                   Content="Log folder" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
