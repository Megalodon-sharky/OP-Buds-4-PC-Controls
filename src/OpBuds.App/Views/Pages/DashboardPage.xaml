<UserControl x:Class="OpBuds.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer Padding="14,4,14,16" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ui:InfoBar Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="{Binding Buds.ChannelBusy, Mode=OneWay}"
                        Message="Something else holds the earbuds' control channel. Close the earbud settings page on your phone."
                        Severity="Warning"
                        Title="Control channel busy" />

            <ui:InfoBar Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="{Binding Buds.LastError, Mode=OneWay, Converter={StaticResource HasValue}}"
                        Message="{Binding Buds.LastError, Mode=OneWay}"
                        Severity="Error"
                        Title="Last error" />

            <!--  Connection  -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{Binding Buds.StatusText, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource Muted}"
                                   Text="{Binding Buds.WearText, Mode=OneWay}" />
                    </StackPanel>

                    <ui:ProgressRing Grid.Column="1"
                                     Width="22"
                                     Height="22"
                                     IsIndeterminate="True"
                                     Visibility="{Binding Buds.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!--
                Battery as the phone shows it: a case badge and L / R discs with the number
                beside them. No bars - a percentage already says everything a bar would,
                and three bars in a narrow window said it three times.
            -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="BATTERY" />
            <Border Style="{StaticResource Card}">
                <WrapPanel Orientation="Horizontal">

                    <StackPanel Margin="0,2,4,2" Orientation="Horizontal">
                        <Grid Width="21" Height="16" VerticalAlignment="Center">
                            <Border Background="{StaticResource Ink}" CornerRadius="6" />
                            <Border Width="10"
                                    Height="3"
                                    Margin="0,-2,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#FF16161A"
                                    CornerRadius="1.5" />
                        </Grid>
                        <TextBlock Style="{StaticResource BatteryValue}"
                                   Text="{Binding Buds.CasePercent, Mode=OneWay, Converter={StaticResource Percent}}" />
                    </StackPanel>

                    <StackPanel Margin="0,2,4,2" Orientation="Horizontal">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource Ink}" />
                            <TextBlock Style="{StaticResource BudLetter}" Text="L" />
                        </Grid>
                        <TextBlock Style="{StaticResource BatteryValue}"
                                   Text="{Binding Buds.LeftPercent, Mode=OneWay, Converter={StaticResource Percent}}" />
                    </StackPanel>

                    <StackPanel Margin="0,2,4,2" Orientation="Horizontal">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource Ink}" />
                            <TextBlock Style="{StaticResource BudLetter}" Text="R" />
                        </Grid>
                        <TextBlock Style="{StaticResource BatteryValue}"
                                   Text="{Binding Buds.RightPercent, Mode=OneWay, Converter={StaticResource Percent}}" />
                    </StackPanel>

                    <ui:Button Margin="0,2,0,2"
                               VerticalAlignment="Center"
                               Appearance="Secondary"
                               Command="{Binding RefreshCommand}"
                               Content="Refresh"
                               Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </WrapPanel>
            </Border>

            <!--  Noise control: four choices, strength only when it applies  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="NOISE CONTROL" />
            <Border Style="{StaticResource Card}">
                <StackPanel IsEnabled="{Binding Buds.IsConnected, Mode=OneWay}">
                    <ItemsControl ItemsSource="{Binding Anc.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Margin="0,3"
                                             Command="{Binding DataContext.Anc.SetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding Group}"
                                             Content="{Binding Label}"
                                             FontSize="14"
                                             GroupName="AncDashboard">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                                            <Binding Path="DataContext.Anc.CurrentGroup" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="Group" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ComboBox Margin="26,6,0,0"
                              HorizontalAlignment="Left"
                              MinWidth="170"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding Anc.Levels}"
                              SelectedItem="{Binding Anc.SelectedLevel, Mode=TwoWay}"
                              Visibility="{Binding Anc.IsNoiseCancelling, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!--  Find  -->
            <ui:Button HorizontalAlignment="Left"
                       Command="{Binding FindCommand}"
                       Content="Find my earbuds…"
                       Icon="{ui:SymbolIcon Speaker224}"
                       IsEnabled="{Binding Buds.IsConnected, Mode=OneWay}" />
            <TextBlock Margin="2,8,0,0"
                       Style="{StaticResource Muted}"
                       Text="Rings at locate volume. Take them out of your ears first — the tone stops on its own and there is no stop command." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
