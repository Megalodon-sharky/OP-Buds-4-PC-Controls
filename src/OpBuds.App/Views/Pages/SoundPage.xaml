<UserControl x:Class="OpBuds.App.Views.Pages.SoundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer Padding="14,4,14,16" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <ui:InfoBar Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="{Binding Buds.LastError, Mode=OneWay, Converter={StaticResource HasValue}}"
                        Message="{Binding Buds.LastError, Mode=OneWay}"
                        Severity="Error"
                        Title="Last error" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="NOISE CONTROL" />
            <Border Style="{StaticResource Card}">
                <StackPanel IsEnabled="{Binding Buds.IsConnected, Mode=OneWay}">
                    <ItemsControl ItemsSource="{Binding Anc.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Margin="0,3"
                                             Command="{Binding DataContext.Anc.SetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding Group}"
                                             Content="{Binding Label}"
                                             FontSize="14"
                                             GroupName="AncSound">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                                            <Binding Path="DataContext.Anc.CurrentGroup" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="Group" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ComboBox Margin="26,6,0,0"
                              MinWidth="170"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding Anc.Levels}"
                              SelectedItem="{Binding Anc.SelectedLevel, Mode=TwoWay}"
                              Visibility="{Binding Anc.IsNoiseCancelling, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="EQUALISER" />
            <Border Style="{StaticResource Card}">
                <ItemsControl IsEnabled="{Binding Buds.IsConnected, Mode=OneWay}" ItemsSource="{Binding EqOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Margin="0,3"
                                         Command="{Binding DataContext.SetEqCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding Preset}"
                                         Content="{Binding Label}"
                                         FontSize="14"
                                         GroupName="EqSound">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                                        <Binding Path="DataContext.Buds.CurrentEq" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding Path="Preset" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--
                The range comes from the earbuds' own reading, never from a constant. Minimum
                and Maximum sit before Value on purpose: a Slider coerces its value into its
                current range, so the range has to exist first.
            -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="BASSWAVE" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid IsEnabled="{Binding CanSetBassWave, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Slider VerticalAlignment="Center"
                                AutomationProperties.Name="BassWave level"
                                IsSnapToTickEnabled="True"
                                LargeChange="1"
                                Minimum="{Binding BassWaveMinimum, Mode=OneWay}"
                                Maximum="{Binding BassWaveMaximum, Mode=OneWay}"
                                SmallChange="1"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                Value="{Binding BassWaveLevel, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1"
                                   MinWidth="34"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding BassWaveText, Mode=OneWay}"
                                   TextAlignment="Right" />
                    </Grid>

                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource Muted}"
                               Text="{Binding BassWaveNote, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="CUSTOM PROFILES" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Buds.CustomEqProfiles, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <ItemsControl ItemsSource="{Binding Bands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="12">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0,6} Hz   {1,4:+#;-#;0} dB">
                                                            <Binding Path="FrequencyHz" />
                                                            <Binding Path="GainDb" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No custom profile saved on the earbuds.">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource Muted}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Buds.CustomEqProfiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
