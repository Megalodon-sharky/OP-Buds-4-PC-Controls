<Page x:Class="OpBuds.App.Views.Pages.SoundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Sound">

    <ScrollViewer Padding="16,4,16,16" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="NOISE CONTROL" />
            <Border Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ItemsControl IsEnabled="{Binding Buds.IsConnected, Mode=OneWay}" ItemsSource="{Binding AncOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Margin="0,2"
                                         Command="{Binding DataContext.SetAncCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         CommandParameter="{Binding Mode}"
                                         Content="{Binding Label}"
                                         GroupName="AncSound">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                                        <Binding Path="DataContext.Buds.CurrentAnc" RelativeSource="{RelativeSource AncestorType=Page}" />
                                        <Binding Path="Mode" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="EQUALISER" />
            <Border Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ItemsControl IsEnabled="{Binding Buds.IsConnected, Mode=OneWay}" ItemsSource="{Binding EqOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Margin="0,2"
                                         Command="{Binding DataContext.SetEqCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         CommandParameter="{Binding Preset}"
                                         Content="{Binding Label}"
                                         GroupName="EqSound">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                                        <Binding Path="DataContext.Buds.CurrentEq" RelativeSource="{RelativeSource AncestorType=Page}" />
                                        <Binding Path="Preset" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--
                BassWave and the custom profiles are read-only. Their setter command ids are
                still inherited Buds Pro 3 guesses that have never been transmitted to this
                hardware, and the 0x04xx space is not guessed at.
            -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="BASSWAVE" />
            <Border Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding Buds.BassWave.Current, Mode=OneWay, StringFormat=Level {0}, FallbackValue=No reading}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Style="{StaticResource Muted}"
                               Text="Read-only for now — the level setter has never been sent to this hardware." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="CUSTOM PROFILES" />
            <Border Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Buds.CustomEqProfiles, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <ItemsControl ItemsSource="{Binding Bands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="12"
                                                           Style="{StaticResource Muted}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0,6} Hz   {1,4:+#;-#;0} dB">
                                                            <Binding Path="FrequencyHz" />
                                                            <Binding Path="GainDb" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock FontSize="12" Text="No custom profile saved on the earbuds.">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource Muted}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Buds.CustomEqProfiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
