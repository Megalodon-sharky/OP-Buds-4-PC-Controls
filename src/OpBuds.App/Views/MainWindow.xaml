<ui:FluentWindow x:Class="OpBuds.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:OpBuds.App.Views.Pages"
                 Title="OnePlus Buds 4"
                 Width="440"
                 Height="640"
                 MinWidth="380"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="OnePlus Buds 4"
                     ShowMaximize="False" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="LeftFluent"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           FrameMargin="0"
                           TransitionDuration="150">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard"
                                       TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Sound"
                                       TargetPageType="{x:Type pages:SoundPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="MusicNote124" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Controls"
                                       TargetPageType="{x:Type pages:ControlsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="HandDraw24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Device"
                                       TargetPageType="{x:Type pages:DevicePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Bluetooth24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"
                                       TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--
                    Developer ships in v1 on purpose. It is not a user feature; it is how
                    everything else gets diagnosed while the protocol map still has holes.
                -->
                <ui:NavigationViewItem Content="Developer"
                                       TargetPageType="{x:Type pages:DeveloperPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CodeBlock24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
